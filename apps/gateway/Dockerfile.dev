# Dev image — npm-workspace layout. Build context = repo root (see docker/docker-compose.dev.yml).
# The gateway src is bind-mounted at runtime for hot reload; @heyriz/shared is built into
# the image, so rebuild this image if you change shared/src.
FROM node:22-bookworm-slim
WORKDIR /app

# Workspace manifests (every workspace in the root lockfile must be present for npm install)
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/billing/package.json ./apps/billing/
COPY apps/ai-core/package.json ./apps/ai-core/
COPY apps/worker/package.json ./apps/worker/
RUN npm install

# Shared package (built) + app source (overlaid by the bind mount at runtime)
COPY shared ./shared
COPY apps/gateway ./apps/gateway
RUN npm run build -w shared

EXPOSE 4000
CMD ["npm", "run", "start:dev", "-w", "apps/gateway"]
