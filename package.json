{
  "name": "heyriz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "apps/gateway",
    "apps/billing",
    "apps/ai-core",
    "apps/worker"
  ],
  "scripts": {
    "dev": "next dev web",
    "dev:web": "next dev web -H 0.0.0.0 -p 3000",
    "dev:gateway": "npm run start:dev -w apps/gateway",
    "dev:billing": "npm run start:dev -w apps/billing",
    "dev:ai-core": "npm run start:dev -w apps/ai-core",
    "dev:worker": "npm run start:dev -w apps/worker",
    "build": "next build web && npm run build:server",
    "build:server": "npm run build -w shared && npm run build -w apps/gateway && npm run build -w apps/billing && npm run build -w apps/ai-core && npm run build -w apps/worker",
    "start": "next start web",
    "start:web": "next start web -H 0.0.0.0 -p 3000",
    "start:gateway": "npm run start:prod -w apps/gateway",
    "start:billing": "npm run start:prod -w apps/billing",
    "start:ai-core": "npm run start:prod -w apps/ai-core",
    "start:worker": "npm run start:prod -w apps/worker",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "smoke:boot": "npm run smoke:boot -w apps/ai-core",
    "smoke:agent": "npm run smoke:agent -w apps/ai-core",
    "smoke:memory": "npm run smoke:memory -w apps/ai-core",
    "smoke:conversation": "npm run smoke:conversation -w apps/gateway",
    "smoke:telegram": "npm run smoke:telegram -w apps/gateway",
    "smoke:automemory": "npm run smoke:automemory -w apps/ai-core",
    "smoke:gmailthreading": "npm run smoke:gmailthreading -w apps/ai-core"
  },
  "dependencies": {
    "framer-motion": "^12.41.0",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
