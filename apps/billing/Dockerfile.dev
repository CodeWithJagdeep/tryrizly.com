# Dev image — npm-workspace layout. The billing src is bind-mounted at runtime
# for hot reload; rebuild this image if shared/src changes.
FROM node:22-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/billing/package.json ./apps/billing/
COPY apps/ai-core/package.json ./apps/ai-core/
COPY apps/worker/package.json ./apps/worker/
RUN npm install

COPY shared ./shared
COPY apps/billing ./apps/billing
RUN npm run build -w shared

EXPOSE 4200
CMD ["npm", "run", "start:dev", "-w", "apps/billing"]
